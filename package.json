{
  "name": "gotopik",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts server/tts/*.test.ts",
    "migrate": "tsx server/database-migrate.ts",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "6.4.1",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "jose": "6.1.0",
    "mysql2": "3.15.3",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
